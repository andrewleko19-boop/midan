{
  "name": "midan-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Midan V1 frontend prototype (mock data, local state only)",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "node scripts/audit.mjs",
    "audit:dist": "node scripts/audit.mjs --dist",
    "brand:copy": "node scripts/copy-brand-assets.mjs",
    "brand:verify": "node scripts/copy-brand-assets.mjs --verify",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run brand:verify && npm run build && npm run audit:dist"
  },
  "dependencies": {
    "@fontsource/readex-pro": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
